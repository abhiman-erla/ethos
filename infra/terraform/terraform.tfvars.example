aws_region        = "us-east-1"
github_repository = "YOUR_GITHUB_USERNAME/ethos"

# GitHub repositories using immutable OIDC subjects can provide the exact claim:
# github_oidc_subjects = ["repo:OWNER@OWNER_ID/ethos@REPOSITORY_ID:environment:production"]

# If the GitHub OIDC provider already exists in this AWS account:
# create_github_oidc_provider = false
# github_oidc_provider_arn    = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
